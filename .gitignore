# ---- 虚拟环境 (1 GB / 41775 个文件, 绝对不能进仓库) ----
.venv/
venv/
env/

# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# ---- 编辑器 / 系统 ----
.vscode/
.idea/
.DS_Store
Thumbs.db
desktop.ini

# ---- 本项目 ----
# 手工备份。git 本身就是版本管理, 这些不需要进仓库。
*.bak

# 运行日志 (每次跑都变, 且能重新生成)
results/*.log

# 说明: 以下几类**故意**纳入版本控制, 不要 ignore
#   data/jura.csv          25 KB, 让仓库自包含 (01_load_jura 也能从 OpenML 重新下载)
#   data/jura_prepared.npz 64 KB, 保证所有下游结果基于完全相同的划分
#   results/*.json|csv|pt  最终参数与指标, 报告直接引用
#   figures/*.png          2 MB, 报告用图
#   *.ipynb 的输出          保留, 便于在 GitHub 上直接查看结果
